# Базовый домен homelab — единственный источник правды для адресов сервисов.
# Каждый сервис доступен по адресу <sub>.$DOMAIN.
#
# Чтобы переопределить домен без коммита в Git, скопируйте этот файл в .env:
#   cp .env.example .env
# и поправьте значение. scripts/lib/common.sh читает корневой .env при
# инициализации сервисов (init.sh / scripts/bootstrap-platform.sh).
DOMAIN=example.com

# Язык по умолчанию для приложений (короткий код, например ru, en).
# Единый источник правды: init.sh подставляет в .env сервисов, compose-файлы
# читают как ${DEFAULT_LOCALE}.
DEFAULT_LOCALE=ru

# LAN IP-адрес сервера. Пустое значение = определить автоматически (ip route get).
# Переопределите, только если автоопределение выбирает не тот интерфейс.
SERVER_IP=192.0.2.10

# Каталог, где хранятся данные всех приложений (bind mounts в Compose).
# Единый источник правды: init.sh и compose-файлы используют $APPS_STORAGE_PATH
# вместо захардкоженного пути. По умолчанию — /storage/apps.
APPS_STORAGE_PATH=/storage/apps

# Часовой пояс контейнеров. Единый источник правды: compose-файлы читают
# как ${TZ}.
TZ=Asia/Yekaterinburg

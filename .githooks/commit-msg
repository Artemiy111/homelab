#!/bin/sh
# Проверка сообщения коммита. Правила — в .gitlint и scripts/gitlint_rules.py,
# те же, что гоняет CI в .forgejo/workflows/gitlint.yml.
#
# Версия gitlint пинится с двух сторон: локально ставится brew-формула 0.19.1,
# в CI — те же файлы из зеркала RustFS (clusters/casa/apps/rustfs). Расхождение
# правил между локалью и CI ловит самотест (§ scripts/gitlint-selftest.sh).
set -eu

if ! command -v gitlint >/dev/null 2>&1; then
  echo "gitlint не установлен (brew install gitlint) — коммит остановлен" >&2
  exit 1
fi

gitlint --msg-filename "$1"

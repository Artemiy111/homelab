.freebuff/
node_modules

/.worktrees/

/config.env

# Вложенные независимые git-репозитории с переиспользуемыми компонентами.
# У каждого свой remote и issue-трекер; родитель их не отслеживает.
/packages/

__pycache__/

# Кэш discovery kubectl. Обычно он живёт в ~/.kube/cache, но если в окружении
# процесса нет HOME, kubectl пишет его в текущий каталог — так он попадает
# в корень репозитория. В именах каталогов лежит адрес API-сервера, в
# serverresources.json — перечень group/version/kind кластера. Для публичного
# зеркала это лишнее, поэтому игнорируем в любом месте дерева.
.kube/

# Кэш ansible-lint (автоустановка collections, fact cache).
infra/casa/ansible/.ansible/

# Terraform/OpenTofu: state, кэш провайдеров и планы не коммитятся. В state
# лежат значения, которые провайдеры прочитали из внешних систем (токены,
# endpoint'ы), а в бинарном плане `tofu show` печатает их открытым текстом.
# .terraform.lock.hcl, наоборот, нужен в git: он пинит версии и хеши
# провайдеров, без него init каждый раз резолвит их заново.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash-*.log

# Значения параметров модуля: домен, адреса. В git лежит только пример в
# README модуля.
infra/casa/terraform/*/terraform.tfvars
infra/global/terraform/*/terraform.tfvars
infra/yc/terraform/*/terraform.tfvars
infra/yc/ansible/inventory.yml
infra/yc/ansible/artifacts/

.worktrees

# Бэкапы от `sed -i.bak` и подобных правок: в репозитории они только мусор,
# а нужный файл всегда возвращается из git.
*.bak
*.orig
.DS_Store

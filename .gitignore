.freebuff/
node_modules

/.worktrees/

/config.env

# Приватные значения Helm-чарта: реальный домен и адрес сервера.
platform/homelab/values.private.yaml

# Приватные значения второго Helm-чарта (apps/element/chart): тот же домен и
# адрес. Без записи `git add -A` на сервере увёл бы файл в публичное зеркало.
apps/element/chart/values.private.yaml

# Приватные values Argo Application (домен, externalIPs): merge-patch поверх
# шаблона из argocd/applications/ (см. argocd/README.md).
argocd/applications/*.private.yaml

# Приватные значения platform-манифестов (email ACME, имя RFC2136-ключа):
# merge-patch поверх шаблонов из platform/cert-manager/ (см. её README).
platform/cert-manager/*.private.yaml

# Приватные значения k0s (issuer Zitadel для OIDC-входа apiserver):
# install.sh подставляет его в k0s.yaml вместо плейсхолдера.
platform/k0s/*.private.yaml

# Вложенные независимые git-репозитории с переиспользуемыми компонентами.
# У каждого свой remote и issue-трекер; родитель их не отслеживает.
/packages/

__pycache__/

# Кэш ansible-lint (автоустановка collections, fact cache).
ansible/.ansible/

# Terraform/OpenTofu: state, кэш провайдеров и планы не коммитятся. В state
# лежат значения, которые провайдеры прочитали из внешних систем (токены,
# endpoint'ы), а в бинарном плане `tofu show` печатает их открытым текстом.
# .terraform.lock.hcl, наоборот, нужен в git: он пинит версии и хеши
# провайдеров, без него init каждый раз резолвит их заново.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash-*.log

# Значения параметров модуля: домен, адреса. В git лежит только пример в
# README модуля.
terraform/*/terraform.tfvars

.worktrees
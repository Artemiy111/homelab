if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks не установлен (brew install gitleaks) — коммит остановлен" >&2
  exit 1
fi
gitleaks git --staged --config .gitleaks.toml --no-banner --redact

# Бейджи в docs/status/ — сгенерированный артефакт: если числа в репозитории
# разошлись с ними, README уже врёт. Ловим здесь, а не в CI (issue #610).
if ! out="$(./scripts/status-badges.sh --check 2>&1)"; then
  printf '%s\n' "$out" >&2
  echo "исправь: ./scripts/status-badges.sh && git add docs/status" >&2
  exit 1
fi

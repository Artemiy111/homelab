# remap.config — allowlist upstream'ов (каждое map-правило = разрешённый origin).
# Формат: map <клиентский-префикс> <origin-база> [@plugin=... @pparam=...]
# Клиент приходит на http://ats.ats.svc.cluster.local:8080/<prefix>/<path>,
# ATS идёт в origin по TLS (SNI = host из правила) и кэширует ответ по URL.
# Префикс обязателен: он разделяет кэш между origin'ами с разными путями.
#
# reverse_map для этих правил не нужен: ATS проходит 302 сам
# (number_of_redirections) и Location клиенту не отдаёт.
#
# purge_remap.so подключается на каждое правило (это remap-плагин, в
# plugin.config его быть не должно). Путь к .so полный: имя файла в образе
# remap_purge.so, а плагин ищет себя по имени purge_remap.so.
#
# Секрет PURGE приходит из Secret: entrypoint (см. k8s/deployment.yaml)
# подставляет его в $(ATS_PURGE_TOKEN) и собирает итоговый remap.config в
# /run/ats, поэтому в git секрета нет.
map http://ats.ats.svc.cluster.local:8080/github/  https://github.com/ @plugin=/opt/libexec/trafficserver/remap_purge.so @pparam=--state-file=/var/cache/trafficserver/purge-github @pparam=--header=X-ATS-Purge @pparam=--secret=$(ATS_PURGE_TOKEN)
map http://ats.ats.svc.cluster.local:8080/githubusercontent/ https://raw.githubusercontent.com/ @plugin=/opt/libexec/trafficserver/remap_purge.so @pparam=--state-file=/var/cache/trafficserver/purge-githubusercontent @pparam=--header=X-ATS-Purge @pparam=--secret=$(ATS_PURGE_TOKEN)
map http://ats.ats.svc.cluster.local:8080/godev/   https://go.dev/ @plugin=/opt/libexec/trafficserver/remap_purge.so @pparam=--state-file=/var/cache/trafficserver/purge-godev @pparam=--header=X-ATS-Purge @pparam=--secret=$(ATS_PURGE_TOKEN)
map http://ats.ats.svc.cluster.local:8080/rust/    https://static.rust-lang.org/ @plugin=/opt/libexec/trafficserver/remap_purge.so @pparam=--state-file=/var/cache/trafficserver/purge-rust @pparam=--header=X-ATS-Purge @pparam=--secret=$(ATS_PURGE_TOKEN)
map http://ats.ats.svc.cluster.local:8080/helm/    https://get.helm.sh/ @plugin=/opt/libexec/trafficserver/remap_purge.so @pparam=--state-file=/var/cache/trafficserver/purge-helm @pparam=--header=X-ATS-Purge @pparam=--secret=$(ATS_PURGE_TOKEN)
map http://ats.ats.svc.cluster.local:8080/apache/  https://archive.apache.org/ @plugin=/opt/libexec/trafficserver/remap_purge.so @pparam=--state-file=/var/cache/trafficserver/purge-apache @pparam=--header=X-ATS-Purge @pparam=--secret=$(ATS_PURGE_TOKEN)
map http://ats.ats.svc.cluster.local:8080/docker/  https://download.docker.com/ @plugin=/opt/libexec/trafficserver/remap_purge.so @pparam=--state-file=/var/cache/trafficserver/purge-docker @pparam=--header=X-ATS-Purge @pparam=--secret=$(ATS_PURGE_TOKEN)
map http://ats.ats.svc.cluster.local:8080/tailscale/ https://pkgs.tailscale.com/ @plugin=/opt/libexec/trafficserver/remap_purge.so @pparam=--state-file=/var/cache/trafficserver/purge-tailscale @pparam=--header=X-ATS-Purge @pparam=--secret=$(ATS_PURGE_TOKEN)

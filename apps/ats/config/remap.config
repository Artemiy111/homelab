# remap.config — allowlist upstream'ов (каждое map-правило = разрешённый origin).
# Формат: map <клиентский-префикс> <origin-база>
# Клиент приходит на http://ats.ats.svc.cluster.local:8080/<prefix>/<path>,
# ATS идёт в origin по TLS (SNI = host из правила) и кэширует ответ по URL.
# Префикс обязателен: он разделяет кэш между origin'ами с разными путями.
#
# reverse_map для этих правил не нужен: ATS проходит 302 сам
# (number_of_redirections) и Location клиенту не отдаёт.
map http://ats.ats.svc.cluster.local:8080/github/  https://github.com/
map http://ats.ats.svc.cluster.local:8080/githubusercontent/ https://raw.githubusercontent.com/
map http://ats.ats.svc.cluster.local:8080/godev/   https://go.dev/
map http://ats.ats.svc.cluster.local:8080/rust/    https://static.rust-lang.org/
map http://ats.ats.svc.cluster.local:8080/helm/    https://get.helm.sh/
map http://ats.ats.svc.cluster.local:8080/apache/  https://archive.apache.org/
map http://ats.ats.svc.cluster.local:8080/docker/  https://download.docker.com/
map http://ats.ats.svc.cluster.local:8080/tailscale/ https://pkgs.tailscale.com/

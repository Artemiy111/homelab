{
  "uid": "storage-capacity",
  "title": "Хранилище: заполняемость томов",
  "tags": ["storage", "longhorn", "pvc"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "1m",
  "editable": false,
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": "label_values(kubelet_volume_stats_used_bytes, namespace)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "pvc",
        "label": "PVC",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": "label_values(kubelet_volume_stats_used_bytes{namespace=~\"$namespace\"}, persistentvolumeclaim)",
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Обзор",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "PVC заполнено ≥ 90%",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 3, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "count(kubelet_volume_stats_used_bytes{namespace=~\"$namespace\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\"} >= 0.9)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "PVC заполнено ≥ 75%",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 3, "x": 3, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "count(kubelet_volume_stats_used_bytes{namespace=~\"$namespace\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\"} >= 0.75)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Longhorn: тома не healthy",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 3, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "count(longhorn_volume_robustness{state!=\"healthy\"} == 1)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Longhorn: томов attached",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 3, "x": 9, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "count(longhorn_volume_state{state=\"attached\"} == 1)",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Заполнение PVC (kubelet)",
      "description": "used / capacity по каждому PVC",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sort_desc(100 * kubelet_volume_stats_used_bytes{namespace=~\"$namespace\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 } ] }
        },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Заполнение PVC: $pvc",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "100 * kubelet_volume_stats_used_bytes{persistentvolumeclaim=\"$pvc\"} / kubelet_volume_stats_capacity_bytes{persistentvolumeclaim=\"$pvc\"}",
          "legendFormat": "заполнено, %"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "kubelet_volume_stats_used_bytes{persistentvolumeclaim=\"$pvc\"}",
          "legendFormat": "занято"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "kubelet_volume_stats_capacity_bytes{persistentvolumeclaim=\"$pvc\"}",
          "legendFormat": "ёмкость"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "заполнено, %" }, "properties": [ { "id": "unit", "value": "percent" }, { "id": "max", "value": 100 } ] },
          { "matcher": { "id": "byRegexp", "options": "занято|ёмкость" }, "properties": [ { "id": "unit", "value": "bytes" } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 13,
      "type": "barchart",
      "title": "Заполнение PVC: занято / свободно",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "max by (pvc, kind) (label_replace(label_join(kubelet_volume_stats_used_bytes{namespace=~\"$namespace\"}, \"pvc\", \"/\", \"namespace\", \"persistentvolumeclaim\"), \"kind\", \"занято\", \"\", \"\")) or max by (pvc, kind) (label_replace(label_join(kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\"} - kubelet_volume_stats_used_bytes{namespace=~\"$namespace\"}, \"pvc\", \"/\", \"namespace\", \"persistentvolumeclaim\"), \"kind\", \"свободно\", \"\", \"\"))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        { "id": "merge", "options": {} },
        { "id": "groupingToMatrix", "options": { "rowField": "pvc", "columnField": "kind", "valueField": "Value" } },
        { "id": "organize", "options": { "excludeByName": {}, "renameByName": { "pvc\\kind": "PVC" } } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 80 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "занято" }, "properties": [ { "id": "unit", "value": "bytes" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "свободно" }, "properties": [ { "id": "unit", "value": "bytes" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-gray" } } ] }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "showValue": "auto",
        "xField": "PVC",
        "xTickLabelRotation": 0,
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Longhorn",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "collapsed": false
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Longhorn: занято / ёмкость узлов",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "longhorn_node_storage_usage_bytes",
          "legendFormat": "{{node}} занято"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "longhorn_node_storage_capacity_bytes",
          "legendFormat": "{{node}} ёмкость"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Longhorn: заполнение томов (actual / capacity)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sort_desc(100 * max by (pvc_namespace, pvc) (longhorn_volume_actual_size_bytes) / max by (pvc_namespace, pvc) (longhorn_volume_capacity_bytes))",
          "legendFormat": "{{pvc_namespace}}/{{pvc}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 } ] }
        },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Longhorn: состояние томов (robustness)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum by (state) (longhorn_volume_robustness)",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Файловые системы узла",
      "description": "заполнение по mountpoint (без tmpfs/ramfs)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sort_desc(100 - 100 * node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs\"})",
          "legendFormat": "{{mountpoint}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 } ] }
        },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true }
    }
  ]
}

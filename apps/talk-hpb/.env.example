# Закреплённая версия образа AIO Talk. Датированный тег вида YYYYMMDD_HHMMSS.
TALK_IMAGE_VERSION=20260817_082005

# Nextcloud, к которому подключается HPB (бэкенд проверки подписей).
NC_DOMAIN=nextcloud.${DOMAIN}
# Публичное имя HPB: signaling через Traefik, TURN/STUN напрямую по 3478.
TALK_HOST=talk-signaling.${DOMAIN}
TURN_DOMAIN=talk-signaling.${DOMAIN}
TALK_PORT=3478

# Максимальный битрейт одного медиапотока. 15 Мбит/с (видео) и 25 Мбит/с
# (шаринг экрана) достаточно для 1440p@30fps при отдаче клиентом simulcast-слоёв;
# 12 Мбит/с — минимум для 2K@30fps, 15 Мбит/с — с запасом;
# выше — качество не растёт без 2К-камеры.
TALK_MAX_STREAM_BITRATE=15728640
TALK_MAX_SCREEN_BITRATE=26214400
TZ=Asia/Yekaterinburg

# Диапазон портов TURN-релея eturnal. Каждая медиа-аллокация занимает один порт,
# на звонок нужно несколько. Должен совпадать с диапазоном, публикуемым в compose.
# Диапазон выбран ниже зоны эпифемеральных портов ядра (32768-60999), чтобы
# docker-proxy не конфликтовал с исходящими соединениями хоста.
TALK_RELAY_MIN_PORT=20000
TALK_RELAY_MAX_PORT=20499
# Подсеть LAN-клиентов, которым разрешено релеить медиа (whitelist_peers eturnal).
TALK_RELAY_NETWORK=192.0.2.10/24

# Заменить на независимые случайные секреты. SIGNALING_SECRET и TURN_SECRET
# должны совпадать с теми, что будут введены в настройках Talk (occ-команды).
TURN_SECRET=changeme
SIGNALING_SECRET=changeme
INTERNAL_SECRET=changeme

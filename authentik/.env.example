# Public URL served by Traefik.
AUTHENTIK_HOST=auth.example.net

# PostgreSQL database settings.
AUTHENTIK_POSTGRESQL_DATABASE=authentik
AUTHENTIK_POSTGRESQL_USER=authentik
AUTHENTIK_POSTGRESQL_PASSWORD=replace-with-a-random-password

# Generate once with: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=replace-with-a-random-secret

# Docker subnet of the external traefiknet network.
TRAEFIK_NETWORK_CIDR=172.20.0.0/16

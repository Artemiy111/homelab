# cache.config — политика TTL по origin.
# Без явного Cache-Control/Expires ATS не кэширует (снято в records.yaml:
# required_headers=0), но и не знает, как долго хранить, — поэтому TTL задаём
# здесь. Ассеты релизов с пином версии иммутабельны: версия в пути не меняет
# содержимое, поэтому держим их долго.
#
# dest_domain — имя origin-хоста из remap-правила (после редиректа учитывается
# и хост-цель, если он тоже прописан).
dest_domain=github.com                     ttl-in-cache=90d
dest_domain=release-assets.githubusercontent.com ttl-in-cache=90d
dest_domain=raw.githubusercontent.com      ttl-in-cache=30d
dest_domain=go.dev                         ttl-in-cache=30d
dest_domain=static.rust-lang.org           ttl-in-cache=90d
dest_domain=get.helm.sh                    ttl-in-cache=30d
dest_domain=archive.apache.org             ttl-in-cache=90d
dest_domain=download.docker.com            ttl-in-cache=30d
dest_domain=pkgs.tailscale.com             ttl-in-cache=30d

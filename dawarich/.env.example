# Общий домен homelab; хосты ниже образуются как <sub>.${DOMAIN}.
DOMAIN=example.com
DAWARICH_HOST=dawarich.${DOMAIN}
DAWARICH_VERSION=1.11.0
POSTGRES_DB=dawarich_production
POSTGRES_USER=dawarich
POSTGRES_PASSWORD=replace-with-a-random-secret
SECRET_KEY_BASE=replace-with-a-random-128-character-hex-secret
TZ=Asia/Yekaterinburg
WEB_CONCURRENCY=1
BACKGROUND_PROCESSING_CONCURRENCY=3
APP_CPU_LIMIT=0.50
APP_MEMORY_LIMIT=4G
LOG_MAX_SIZE=100m
LOG_MAX_FILE=5

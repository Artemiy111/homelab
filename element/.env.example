# Element/Matrix stack — copy to .env and fill in secrets
# cp .env.example .env

ELEMENT_HOST=element.${DOMAIN}
SYNAPSE_HOST=element.${DOMAIN}
LIVEKIT_HOST=element.${DOMAIN}

LIVEKIT_EXTERNAL_IP=${SERVER_IP}

# LiveKit ports
LIVEKIT_PORT=7880
LIVEKIT_RTC_PORT=7881
LIVEKIT_RTC_PORT_MIN=50000
LIVEKIT_RTC_PORT_MAX=50499

# Synapse
SYNAPSE_SERVER_NAME=${DOMAIN}
SYNAPSE_REGISTRATION_SHARED_SECRET=

# PostgreSQL
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=

# LiveKit API keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# TURN server
TURN_USER=turnuser
TURN_PASSWORD=
TURN_SECRET=
TURN_REALM=${DOMAIN}
TURN_PORT=3479
TURN_RELAY_MIN_PORT=21000
TURN_RELAY_MAX_PORT=21499

# Push notifications (Firebase/FCM for Android)
FCM_SERVER_KEY=
FCM_SENDER_ID=

# Timezone
TZ=Asia/Yekaterinburg

{
  "default_server_config": {
    "m.homeserver": {
      "base_url": "https://element.ref+envsubst://$DOMAIN+/",
      "server_name": "ref+envsubst://$DOMAIN"
    },
    "m.identity_server": {
      "base_url": "https://vector.im"
    }
  },
  "trusted_domains": ["ref+envsubst://$DOMAIN"],
  "default_theme": "light",
  "plugins": [
    {
      "type": "module",
      "name": "Jitsi",
      "url": "https://voluble-rose-baboon.netlify.app/jitsi.js"
    }
  ],
  "element_call": {
    "enabled": true,
    "url": "https://element.ref+envsubst://$DOMAIN+/",
    "user_id": "https://element.ref+envsubst://$DOMAIN+/",
    "room": ""
  },
  "features": {
    "feature_call": true,
    "feature_element_call_video": true
  },
  "setting_defaults": {
    "feature_element_call_video": true
  },
  "room_dir": {
    "enabled": true,
    "roomServers": ["matrix.org"]
  },
  "login": {
    "mqtt": false,
    "flows": [{"type": "m.login.password"}]
  },
  "disable_login_language_selector": false,
  "set_mxc_hs_endpoint": "https://element.ref+envsubst://$DOMAIN+/"
}

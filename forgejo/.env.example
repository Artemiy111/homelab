# Общий домен homelab; хосты ниже образуются как <sub>.${DOMAIN}.
DOMAIN=example.net
# LAN IP-адрес сервера (init.sh определяет его автоматически).
SERVER_IP=192.0.2.10
FORGEJO_HOST=forgejo.${DOMAIN}
FORGEJO_SSH_PORT=2222

POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Inspect with: docker network inspect traefiknet --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRAEFIK_NETWORK_CIDR=172.20.0.0/16
TZ=Asia/Yekaterinburg

GATUS_HOST=uptime.${DOMAIN}

# Топик ntfy для уведомлений. Значение остаётся только на сервере (.env
# не отслеживается Git); в приложении ntfy подпишитесь на этот же топик.
# Имя топика — по сути пароль: используйте случайную, неугадываемую строку.
NTFY_TOPIC=replace-with-an-unguessable-topic

# Telegram-бот (@BotFather → /newbot): токен и ID чата, куда слать
# уведомления. ID группы отрицательный (для супергрупп с префиксом -100).
TELEGRAM_BOT_TOKEN=replace-with-the-bot-token
TELEGRAM_CHAT_ID=replace-with-the-chat-id
TELEGRAM_PROXY_URL=http://${SERVER_IP}:8440

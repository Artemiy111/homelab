# Общий домен homelab; хосты ниже образуются как <sub>.${DOMAIN}.
DOMAIN=example.net
# LAN IP-адрес сервера (init.sh определяет его автоматически).
SERVER_IP=192.0.2.10
GITEA_HOST=gitea.${DOMAIN}
GITEA_SSH_PORT=2222

POSTGRES_DB=gitea
POSTGRES_USER=gitea
POSTGRES_PASSWORD=replace-with-a-long-random-password

GITEA_ADMIN_USERNAME=gitea-admin
GITEA_ADMIN_PASSWORD=replace-with-a-different-long-random-password
GITEA_ADMIN_EMAIL=gitea-admin@example.invalid
# Inspect with: docker network inspect traefiknet --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRAEFIK_NETWORK_CIDR=172.20.0.0/16
TZ=Asia/Yekaterinburg

GLITCHTIP_VERSION=6

POSTGRES_DB=glitchtip
POSTGRES_USER=glitchtip

VALKEY_URL=redis://valkey:6379/0
ENABLE_USER_REGISTRATION=false
ENABLE_ORGANIZATION_CREATION=true
# Автосоздание пользователя при первом входе через OIDC (независимо от
# ENABLE_USER_REGISTRATION) и разрешение discovery к приватным IP IdP
# (весь homelab в LAN).
ENABLE_SOCIAL_APPS_USER_REGISTRATION=true
SOCIAL_AUTH_BLOCK_PRIVATE_IPS=false

# Общий домен homelab; хосты ниже образуются как <sub>.${DOMAIN}.
DOMAIN=example.net
# Часовой пояс контейнеров (init.sh подставляет его автоматически).
TZ=Asia/Yekaterinburg
WUD_HOST=wud.${DOMAIN}
CUP_HOST=cup.${DOMAIN}

# Docker Hub credentials для Cup (опционально, но рекомендуется):
# PAT с правами read-only (hub.docker.com → Account Settings → Personal Access
# Tokens). Хранятся только в .env; в cup.json попадает base64(логин:токен).
CUP_DOCKERHUB_USERNAME=
CUP_DOCKERHUB_TOKEN=

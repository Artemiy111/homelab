# Общий домен homelab; хосты ниже образуются как <sub>.${DOMAIN}.
DOMAIN=example.net

# Infisical self-hosted configuration.
INFISICAL_HOST=infisical.${DOMAIN}
INFISICAL_VERSION=latest

POSTGRES_DB=infisical
POSTGRES_USER=infisical
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Must be a 32-char hex string (16 bytes). Generate with: openssl rand -hex 16
ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-16

# Must be a random base64 string. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# Database connection (matches the postgres service above). Docker Compose
# substitutes ${POSTGRES_PASSWORD} and ${POSTGRES_DB} from this file.
DB_CONNECTION_URI=postgresql://infisical:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379

# Public URL of the instance.
SITE_URL=https://${INFISICAL_HOST}

# Bind to all interfaces inside the container so Traefik can reach the backend.
HOST=0.0.0.0

# Trust X-Forwarded-* headers only from the Traefik network.
# Inspect with: docker network inspect traefiknet --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_PROXY_CIDRS=172.20.0.0/16

TELEMETRY_ENABLED=false

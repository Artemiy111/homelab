# Infisical self-hosted configuration
# Generate keys: openssl rand -hex 16 (ENCRYPTION_KEY), openssl rand -base64 32 (AUTH_SECRET)

INFISICAL_HOST=infisical.example.net
INFISICAL_VERSION=latest

POSTGRES_DB=infisical
POSTGRES_USER=infisical
POSTGRES_PASSWORD=CHANGE_ME

# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=CHANGE_ME

# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME

# Database connection (matches postgres service above)
DB_CONNECTION_URI=postgresql://infisical:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379

# Site URL (public URL for the instance)
SITE_URL=https://${INFISICAL_HOST}

# Keep all docker-jitsi-meet components on the same tested stable release.
JITSI_IMAGE_VERSION=stable-10978

JITSI_HOST=meet.example.net
PUBLIC_URL=https://meet.example.net
TZ=Asia/Yekaterinburg

# The bridge is reachable directly in the LAN and through the Tailscale subnet route.
JVB_BIND_ADDRESS=192.0.2.10
JVB_ADVERTISE_IPS=192.0.2.10
JVB_PORT=10000

# Only registered users create rooms; guests can join an existing room by link.
ENABLE_AUTH=1
ENABLE_GUESTS=1
AUTH_TYPE=internal

# Replace all values below with independent random secrets.
JICOFO_COMPONENT_SECRET=changeme
JICOFO_AUTH_PASSWORD=changeme
JVB_AUTH_PASSWORD=changeme

[TEMPLATE]
# ZITADEL IdP (issuer). Must match ZITADEL_HOST in zitadel/.env.
ZITADEL_HOST=id.example.net

# Public host of oauth2-proxy itself (OIDC callback + session cookie).
OAUTH2_PROXY_HOST=oauth.example.net

# OIDC client created in ZITADEL with redirect URI:
#   https://oauth.example.net/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=replace-with-zitadel-client-id
OAUTH2_PROXY_CLIENT_SECRET=replace-with-zitadel-client-secret

# Generate once with: openssl rand -base64 32 | tr -d '\n' | tr '+/' '-_'
# oauth2-proxy expects URL-safe base64 of a 16/24/32-byte key.
OAUTH2_PROXY_COOKIE_SECRET=replace-with-a-random-secret

# Pinned image version (check latest patch before deploy).
OAUTH2_PROXY_VERSION=v7.15.0

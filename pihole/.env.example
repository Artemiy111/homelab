# Общий домен homelab; хосты ниже образуются как <sub>.${DOMAIN}.
DOMAIN=example.com
# LAN IP-адрес сервера (init.sh определяет его автоматически).
SERVER_IP=192.0.2.10
# Часовой пояс контейнеров (init.sh подставляет его автоматически).
TZ=Asia/Yekaterinburg
PIHOLE_HOST=pihole.${DOMAIN}
PIHOLE_ADMIN_PASSWORD=replace-with-a-long-random-password

PGWEB_HOST=postgres.${DOMAIN}

# Тестовая база и пользователь с полными правами в ней.
POSTGRES_DB=playground
POSTGRES_USER=playground
POSTGRES_PASSWORD=replace-with-a-random-hex-password

# HTTP Basic Auth перед интерфейсом pgweb.
PGWEB_AUTH_USER=pgweb
PGWEB_AUTH_PASS=replace-with-another-random-hex-password

# Каталог данных приложений на Docker-хосте.
APPS_STORAGE_PATH=/storage/apps

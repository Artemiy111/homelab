# Этот пароль шифрует репозиторий. Без него восстановление невозможно.
RESTIC_PASSWORD=replace-with-a-long-random-password

# Оба пути по умолчанию находятся на одном диске и не защищают от его отказа.
# BACKUP_SOURCE пуст — берётся $APPS_STORAGE_PATH из корневого .env (по умолчанию /storage/apps).
BACKUP_SOURCE=
CONFIG_SOURCE=/home/artlab/projects/homelab
RESTIC_REPOSITORY_PATH=/storage/backups/restic

# Общий домен homelab; хосты ниже образуются как <sub>.${DOMAIN}.
DOMAIN=example.com
APPS_STORAGE_PATH=/storage/apps

# Seafile version and public URL.
SEAFILE_HOST=seafile.${DOMAIN}
SEAFILE_VERSION=13.0.25
SEAFILE_SERVER_HOSTNAME=seafile.${DOMAIN}
SEAFILE_SERVER_PROTOCOL=https
TIME_ZONE=Asia/Yekaterinburg
JWT_PRIVATE_KEY=replace-with-a-random-hex-key

# Seafile cache.
CACHE_PROVIDER=redis
REDIS_HOST=redis
REDIS_PORT=6379

# The first account is created only on the initial startup.
INIT_SEAFILE_ADMIN_EMAIL=seafile-admin@${DOMAIN}
INIT_SEAFILE_ADMIN_PASSWORD=replace-with-a-long-random-password

# MariaDB bootstrap and Seafile database settings.
INIT_SEAFILE_MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
SEAFILE_MYSQL_DB_HOST=db
SEAFILE_MYSQL_DB_PORT=3306
SEAFILE_MYSQL_DB_USER=seafile
SEAFILE_MYSQL_DB_PASSWORD=replace-with-another-long-random-password
SEAFILE_MYSQL_DB_CCNET_DB_NAME=ccnet_db
SEAFILE_MYSQL_DB_SEAFILE_DB_NAME=seafile_db
SEAFILE_MYSQL_DB_SEAHUB_DB_NAME=seahub_db

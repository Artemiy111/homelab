# Общий домен homelab; хосты ниже образуются как <sub>.${DOMAIN}.
DOMAIN=example.net
# LAN IP-адрес сервера (init.sh определяет его автоматически).
SERVER_IP=192.0.2.10

# Закреплённая версия образа AIO Talk. Датированный тег вида YYYYMMDD_HHMMSS.
TALK_IMAGE_VERSION=20260817_082005

# Nextcloud, к которому подключается HPB (бэкенд проверки подписей).
NC_DOMAIN=nextcloud.${DOMAIN}
# Публичное имя HPB: signaling через Traefik, TURN/STUN напрямую по 3478.
TALK_HOST=talk-signaling.${DOMAIN}
TURN_DOMAIN=talk-signaling.${DOMAIN}
TALK_PORT=3478

# Максимальный битрейт одного медиапотока. Значения выше дефолтных (1 и 2 Мбит/с)
# поднимают качество видео и шаринга экрана; ниже — экономия полосы сервера.
TALK_MAX_STREAM_BITRATE=4194304
TALK_MAX_SCREEN_BITRATE=8388608
TZ=Asia/Yekaterinburg

# Заменить на независимые случайные секреты. SIGNALING_SECRET и TURN_SECRET
# должны совпадать с теми, что будут введены в настройках Talk (occ-команды).
TURN_SECRET=changeme
SIGNALING_SECRET=changeme
INTERNAL_SECRET=changeme
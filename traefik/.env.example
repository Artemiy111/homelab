TRAEFIK_HOST=traefik.example.net
TRAEFIK_DASHBOARD_USERNAME=admin
TRAEFIK_DASHBOARD_PASSWORD=replace-with-a-long-random-password
# Вставьте полный вывод `htpasswd -nbB`, сохранив одинарные кавычки.
TRAEFIK_DASHBOARD_USERS='admin:$2y$05$replace-with-a-real-bcrypt-hash'

# ACME account and <dns-provider> RFC2136 credentials for DNS-01.
RFC2136_NAMESERVER=ns1.<dns-provider>.com:53
RFC2136_TSIG_ALGORITHM=hmac-sha256.
RFC2136_TSIG_KEY=replace-with-the-<dns-provider>-tsig-key-name
RFC2136_TSIG_SECRET=replace-with-the-<dns-provider>-tsig-secret

LETSENCRYPT_EMAIL=replace-with-your-email-address
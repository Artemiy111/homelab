# Общий домен homelab; хосты ниже образуются как <sub>.${DOMAIN}.
DOMAIN=example.com

# Public URL served by Traefik.
ZITADEL_HOST=id.${DOMAIN}

# Pinned images (zitadel + zitadel-login share this tag).
# Before bumping, check release notes: #12473 (passkey login stuck when an extra
# MFA method exists) is still open as of 4.17.1.
ZITADEL_VERSION=v4.17.1

# PostgreSQL (ZITADEL requires >= 14).
# POSTGRES_PASSWORD goes into the DSN, so use URL-safe chars only, e.g.:
#   openssl rand -hex 24
POSTGRES_DB=zitadel
POSTGRES_USER=zitadel
POSTGRES_PASSWORD=replace-with-a-random-password

# Initial admin. Login name: admin@zitadel.id.example.com
# (format: USERNAME@<org>.<domain>, default org is "zitadel").
# Password policy: >= 8 chars, upper+lower+number+symbol.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-complex-password

# Masterkey encrypts all secrets. Must be exactly 32 characters. Generate once:
#   openssl rand -hex 16
ZITADEL_MASTERKEY=replace-with-a-random-32-char-masterkey


ZITADEL_HOST=id.${DOMAIN}

# Pinned images (zitadel + zitadel-login share this tag).
# Before bumping, check release notes: #12473 (passkey login stuck when an extra
# MFA method exists) is still open as of 4.17.1.
ZITADEL_VERSION=v4.17.1

# PostgreSQL (ZITADEL requires >= 14).
# Пароли идут в DSN/CREATE ROLE, поэтому использовать URL-safe символы, напр.:
#   openssl rand -hex 24
POSTGRES_DB=zitadel

# Суперпользователь кластера: нужен только initdb-скрипту (создание роли
# zitadel), backup-db и ручным работам в базе.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-random-password

# Непривилегированный пользователь, под которым работает ZITADEL
# (владелец базы zitadel).
POSTGRES_ZITADEL_USER=zitadel
POSTGRES_ZITADEL_PASSWORD=replace-with-a-random-password

# Initial admin. Login name: admin@zitadel.id.example.com
# (format: USERNAME@<org>.<domain>, default org is "zitadel").
# Password policy: >= 8 chars, upper+lower+number+symbol.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-complex-password

# Masterkey в .env не хранится: `init.sh` создаёт файл
# $APPS_STORAGE_PATH/zitadel/masterkey (0600), он монтируется в контейнер
# read-only и передаётся через --masterkeyFile. После инициализации базы
# ключ менять нельзя.

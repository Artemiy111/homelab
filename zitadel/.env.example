# Public URL served by Traefik.
ZITADEL_HOST=id.example.net

# Pinned images (zitadel + zitadel-login share this tag).
# Before bumping, check release notes: 4.16.1 has an open passkey bug #12473.
ZITADEL_VERSION=v4.15.1

# PostgreSQL (ZITADEL requires >= 14).
# POSTGRES_PASSWORD goes into the DSN, so use URL-safe chars only, e.g.:
#   openssl rand -hex 24
POSTGRES_DB=zitadel
POSTGRES_USER=zitadel
POSTGRES_PASSWORD=replace-with-a-random-password

# Initial admin. Login name: admin@zitadel.id.example.net
# (format: USERNAME@<org>.<domain>, default org is "zitadel").
# Password policy: >= 8 chars, upper+lower+number+symbol.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-complex-password

# Masterkey encrypts all secrets. Generate once and never change:
#   openssl rand -base64 32 | tr -d '\n'
ZITADEL_MASTERKEY=replace-with-a-random-masterkey
